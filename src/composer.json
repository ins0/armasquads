{
    "name": "ins0/armasquads",
    "description": "Website for creating Squad XML files in ArmA based games",
    "type": "project",
    "license": "GPL-2.0-only",
    "require": {
        "php": ">=8.4",
        "ext-imagick": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Armasquads\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Armasquads\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform-check": "php-only"
    },
    "scripts": {
        "test": "phpunit"
    }
}
