<?php
/** @var Armasquads\View $this */
/** @var Armasquads\Model\Squad $squad */
/** @var ?string $logoPng */
/** @var list<array<string, mixed>> $rows */
/** @var list<string> $errors */
$this->headTitle('Members');
$fields = [
    'uuid' => 'PlayerID *',
    'username' => 'Username *',
    'name' => 'Name',
    'email' => 'Email',
    'icq' => 'ICQ',
    'remark' => 'Remark',
];
$memberRow = function (string $index, array $row) use ($fields): string {
    $html = '';
    foreach ($fields as $field => $label) {
        $value = is_scalar($row[$field] ?? null) ? (string) $row[$field] : '';
        $html .= '<div class="form-group">'
            . '<label class="col-xs-12 col-sm-2 control-label">' . $label . '</label>'
            . '<input type="text" name="members[' . $index . '][' . $field . ']" class="' . $field . ' col-xs-12 col-sm-8" value="' . $this->escapeHtml($value) . '">'
            . '</div>';
    }

    return '<div class="item panel panel-default member"><div class="panel-body"><fieldset><legend>Member</legend>' . $html . '</fieldset>'
        . '<label>* required fields</label></div>'
        . '<div class="panel-footer text-right"><div class="btn btn-danger remove-member">' . $this->escapeHtml($this->translate('Delete')) . '</div></div></div>';
};
?>
<?= $this->formErrors($errors) ?>
<div class="page-header">
    <h1 id="type">
        <?php if ($logoPng !== null): ?>
            <img width="64" height="64" src="<?= $this->escapeHtml($this->basePath($logoPng)) ?>" class="img-circle" />
        <?php endif; ?>
        »<em><?= $this->escapeHtml($squad->tag) ?></em>«
        <?= $this->escapeHtml($squad->name) ?>
    </h1>
</div>
<div class="panel panel-default">
    <div class="panel-body">
        <legend>Search</legend>
        <input id="memberSearch" placeholder="PlayerID / Username" type="text" style="width: 100%" value="" />
    </div>
</div>
<div class="well">
    <form method="post" class="form-horizontal" name="squad" id="squad" action="<?= $this->url('squad-members', ['id' => $squad->id]) ?>">
        <?= $this->csrfField() ?>
        <legend>Display <span id="member-count-display"><?= count($rows) ?></span> out of <span class="member-count"><?= count($rows) ?></span> Members</legend>
        <div class="members">
            <div class="members-collection">
                <p class="no-member-hint"<?= $rows !== [] ? ' style="display: none;"' : '' ?>><?= $this->escapeHtml($this->translate('This squad has no member!')) ?></p>
                <?php foreach ($rows as $index => $row): ?>
                    <?= $memberRow((string) $index, $row) ?>
                <?php endforeach; ?>
            </div>
        </div>
        <hr>
        <a href="<?= $this->url('squads') ?>" class="btn btn-danger"><?= $this->escapeHtml($this->translate('Back')) ?></a>
        <button type="submit" class="btn btn-success"><?= $this->escapeHtml($this->translate('Save')) ?></button>
        <div class="btn btn-primary add-member">Add a new Member</div>
    </form>
    <template id="member-template"><?= $memberRow('__index__', []) ?></template>
</div>
